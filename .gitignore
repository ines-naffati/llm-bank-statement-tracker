# Secrets — ne doit JAMAIS partir sur GitHub
.env

# Données personnelles: base, sauvegardes, relevés PDF importés.
# On ignore tout `data/` : l'application crée elle-même ses dossiers au démarrage,
# donc rien de ce dossier n'a besoin d'être versionné.
data/

# Captures d'écran de relevés bancaires (ayant servi de jeu de test)
capture ecran/
*.pdf

# Jeu de test transcrit depuis de vrais relevés: contient des noms de commerçants,
# des montants et un numéro de compte réels. Reste en local.
scripts/seed_from_screenshots.py

# Python
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/

# macOS
.DS_Store

# Base de demonstration (regeneree par scripts/seed_demo.py)
demo_data/

# Outillage local de l'assistant de code
.claude/
