# "claude" (payant, ~1e/an pour cet usage, plus fiable) ou "ollama" (gratuit, local, moins fiable)
EXTRACTION_BACKEND=claude

# Requis seulement si EXTRACTION_BACKEND=claude
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-5

# Requis seulement si EXTRACTION_BACKEND=ollama (Ollama doit tourner en local: `ollama serve`)
OLLAMA_MODEL=llama3.2:3b
OLLAMA_HOST=http://localhost:11434
